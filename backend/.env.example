# ==============================================================================
# TECHBLOG BACKEND CONFIGURATION TEMPLATE
# ==============================================================================

# Server Environment & Port
PORT=5001
NODE_ENV=development

# Database - MongoDB Atlas Cloud Connection String
# Obtain from MongoDB Atlas -> Deployment -> Database -> Connect -> Drivers -> Node.js
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<dbname>?retryWrites=true&w=majority
# Note: Keep password URL-encoded if it contains special characters (@, :, /, etc.)
MONGODB_URI=

# JWT Authentication Secret (High entropy >= 32 characters required in production)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRE=30d

# Cloudinary Image Storage (Optional in local dev; falls back to /uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production Administrator Credentials (Required for production setup)
# Do NOT use default passwords or admin@techblog.internal in production
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Editorial Director

# CORS Client Origin
CLIENT_URL=http://localhost:5173
