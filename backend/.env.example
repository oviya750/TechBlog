# Server Port
PORT=5001
NODE_ENV=development

# Database - MongoDB Atlas Connection String
# e.g.: mongodb+srv://<username>:<password>@cluster0.mongodb.net/techblog?retryWrites=true&w=majority
MONGODB_URI=

# JWT Secret Key
JWT_SECRET=techblog_super_secret_jwt_key_nature_tech_2026_dev_env

# Cloudinary Image Storage (Optional in local dev, fallback local uploads provided)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Production Admin Credentials (Required for initial production setup)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
